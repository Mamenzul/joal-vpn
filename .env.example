# JOAL + gluetun settings. Copy to .env and fill in. NEVER commit .env.

# Proton VPN WireGuard private key: the "PrivateKey" line of a config downloaded from
# account.protonvpn.com -> Downloads -> WireGuard configuration
WIREGUARD_PRIVATE_KEY=
# Comma-separated Proton server countries, e.g. Switzerland,Netherlands
SERVER_COUNTRIES=Switzerland

# Timezone for container logs
TZ=Europe/Paris

# JOAL WebUI port (published on 127.0.0.1 only)
JOAL_PORT=8080

# Obfuscation path + password for the JOAL WebUI: pick long random strings
JOAL_PATH_PREFIX=change-me-path
JOAL_SECRET_TOKEN=change-me-token

# Your LAN, so gluetun's firewall allows replies to the published port
LAN_SUBNET=192.168.1.0/24
